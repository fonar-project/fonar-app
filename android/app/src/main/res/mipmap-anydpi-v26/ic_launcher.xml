<?xml version="1.0" encoding="utf-8"?>
<!--
  Ícone adaptável (Android 8+), US47: fundo roxo da marca e o símbolo na
  frente; quem recorta (círculo, gota, quadrado) é o aparelho. O
  "monochrome" é o do ícone temático do Android 13+. Abaixo do 8, valem os
  PNG das pastas mipmap-*.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
